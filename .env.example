# Shared app password gating both the builder UI and chat runtime (Constitution: v1 access model).
NEXTGEN_APP_PASSWORD=change-me

# Fernet key encrypting credentials at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXTGEN_CREDENTIAL_KEY=

# Where the backend reaches Ollama. Defaults to the bundled docker-compose service;
# point elsewhere if your team already runs Ollama on shared hardware.
OLLAMA_BASE_URL=http://ollama:11434

# Ollama model used to embed documents/queries for Memory nodes. Must be an
# embeddings-capable model (not a chat model) — pull it once with e.g.:
#   docker compose exec ollama ollama pull nomic-embed-text
NEXTGEN_EMBEDDING_MODEL=nomic-embed-text

# Where Chroma persists vector stores. Defaults to a path inside the same
# /data volume the SQLite DB already uses — no extra volume needed.
NEXTGEN_VECTOR_STORE_PATH=/data/vector_stores

# SerpAPI API key for Google Search tool (`google_search` in backend tool registry).
# Get a free key at https://serpapi.com
SERPAPI_KEY=

# Langfuse Observability & Tracing credentials.
# Get keys at https://cloud.langfuse.com or from your self-hosted Langfuse server.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com


