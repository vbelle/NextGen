{
  "name": "obsidian_vault_search",
  "graph_json": {
    "nodes": [
      {
        "id": "input-1",
        "type": "input",
        "name": "User Question",
        "config": {
          "prompt": "What topic or note would you like to search in your Obsidian vault? (type 'exit' to quit):",
          "required": true
        },
        "position": {
          "x": 100,
          "y": 150
        }
      },
      {
        "id": "decision-1",
        "type": "decision",
        "name": "Check for Exit",
        "config": {
          "left": "{{User Question}}",
          "operator": "contains",
          "right": "exit"
        },
        "position": {
          "x": 350,
          "y": 150
        }
      },
      {
        "id": "exit-response",
        "type": "response",
        "name": "Exit Session",
        "config": {
          "content": "👋 Obsidian search session closed. Thank you!"
        },
        "position": {
          "x": 350,
          "y": 350
        }
      },
      {
        "id": "tool-1",
        "type": "tool",
        "name": "Obsidian Search Tool",
        "config": {
          "function_name": "obsidian_search",
          "description": "Searches the user's Obsidian Vault for personal notes, Markdown documents, and topics.",
          "implementation_ref": "obsidian_search"
        },
        "position": {
          "x": 600,
          "y": 50
        }
      },
      {
        "id": "memory-1",
        "type": "memory",
        "name": "Obsidian Vault Memory RAG",
        "config": {
          "vector_store_ref": "obsidian_vault",
          "query": "{{User Question}}",
          "top_k": 10
        },
        "position": {
          "x": 600,
          "y": 150
        }
      },
      {
        "id": "llm-1",
        "type": "llm",
        "name": "Grounded Knowledge Assistant",
        "config": {
          "provider": "ollama",
          "model": "llama3.2",
          "prompt": "You are a personal knowledge assistant. You have access to the obsidian_search tool and the following retrieved note context from the user's Obsidian vault:\n\n=== RETRIEVED OBSIDIAN NOTES ===\n{{Obsidian Vault Memory RAG}}\n\n=== TOOL AVAILABILITY ===\n{{Obsidian Search Tool}}\n\n=== USER QUESTION ===\n{{User Question}}\n\nAnswer the user's question accurately based on their notes.",
          "timeout_seconds": 180
        },
        "position": {
          "x": 850,
          "y": 150
        }
      },
      {
        "id": "response-1",
        "type": "response",
        "name": "Display Answer",
        "config": {
          "content": "{{Grounded Knowledge Assistant}}"
        },
        "position": {
          "x": 1100,
          "y": 150
        }
      }
    ],
    "edges": [
      {
        "id": "e-input-decision",
        "source": "input-1",
        "source_port": "default",
        "target": "decision-1"
      },
      {
        "id": "e-decision-exit",
        "source": "decision-1",
        "source_port": "true",
        "target": "exit-response"
      },
      {
        "id": "e-decision-memory",
        "source": "decision-1",
        "source_port": "false",
        "target": "memory-1"
      },
      {
        "id": "e-tool-llm",
        "source": "tool-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-memory-llm",
        "source": "memory-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-llm-success",
        "source": "llm-1",
        "source_port": "success",
        "target": "response-1"
      },
      {
        "id": "e-llm-failure",
        "source": "llm-1",
        "source_port": "failure",
        "target": "response-1"
      }
    ]
  }
}
