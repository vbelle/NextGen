{
  "name": "obsidian_vault_search",
  "graph_json": {
    "nodes": [
      {
        "id": "input-1",
        "type": "input",
        "name": "User Question",
        "config": {
          "prompt": "What topic or note would you like to search in your Obsidian vault?",
          "required": true
        },
        "position": {
          "x": 100,
          "y": 150
        }
      },
      {
        "id": "tool-1",
        "type": "tool",
        "name": "Obsidian Search Tool",
        "config": {
          "function_name": "obsidian_search",
          "description": "Searches the user's Obsidian Vault for personal notes, Markdown documents, and topics.",
          "implementation_ref": "obsidian_search"
        },
        "position": {
          "x": 100,
          "y": 350
        }
      },
      {
        "id": "memory-1",
        "type": "memory",
        "name": "Obsidian Vault Memory RAG",
        "config": {
          "vector_store_ref": "obsidian_vault",
          "query": "{{previous}}",
          "top_k": 5
        },
        "position": {
          "x": 350,
          "y": 150
        }
      },
      {
        "id": "llm-1",
        "type": "llm",
        "name": "Grounded Knowledge Assistant",
        "config": {
          "provider": "ollama",
          "model": "llama3.2",
          "prompt": "You are a personal knowledge assistant. You have access to the obsidian_search tool and the following pre-retrieved note context from the user's Obsidian vault:\n\n{{previous}}\n\nAnswer the user's question accurately based on their notes.",
          "timeout_seconds": 180
        },
        "position": {
          "x": 650,
          "y": 150
        }
      },
      {
        "id": "response-1",
        "type": "response",
        "name": "Display Answer",
        "config": {
          "content": "{{previous}}"
        },
        "position": {
          "x": 950,
          "y": 150
        }
      }
    ],
    "edges": [
      {
        "id": "e-input-memory",
        "source": "input-1",
        "source_port": "default",
        "target": "memory-1"
      },
      {
        "id": "e-tool-llm",
        "source": "tool-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-memory-llm",
        "source": "memory-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-llm-success",
        "source": "llm-1",
        "source_port": "success",
        "target": "response-1"
      },
      {
        "id": "e-llm-failure",
        "source": "llm-1",
        "source_port": "failure",
        "target": "response-1"
      }
    ]
  }
}
