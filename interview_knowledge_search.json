{
  "name": "interview_knowledge_search",
  "graph_json": {
    "nodes": [
      {
        "id": "input-1",
        "type": "input",
        "name": "User Question",
        "config": {
          "prompt": "Ask any question about interviews, job descriptions (e.g. Capital One, Fidelity), past experience, or system design (type 'exit' to quit):",
          "required": true
        },
        "position": {
          "x": 100,
          "y": 150
        }
      },
      {
        "id": "decision-1",
        "type": "decision",
        "name": "Check for Exit",
        "config": {
          "left": "{{previous}}",
          "operator": "contains",
          "right": "exit"
        },
        "position": {
          "x": 350,
          "y": 150
        }
      },
      {
        "id": "exit-response",
        "type": "response",
        "name": "Exit Session",
        "config": {
          "content": "👋 Search session closed. Thank you!"
        },
        "position": {
          "x": 350,
          "y": 350
        }
      },
      {
        "id": "tool-1",
        "type": "tool",
        "name": "Interview Search Tool",
        "config": {
          "function_name": "interview_search",
          "description": "Searches the candidate's Interview Knowledge Vault (vbelle/Interview) for prep notes, JDs, resume details, and cheatsheets.",
          "implementation_ref": "interview_search"
        },
        "position": {
          "x": 600,
          "y": 50
        }
      },
      {
        "id": "memory-1",
        "type": "memory",
        "name": "Interview Vault Memory RAG",
        "config": {
          "vector_store_ref": "interview_vault",
          "query": "{{previous}}",
          "top_k": 10
        },
        "position": {
          "x": 600,
          "y": 150
        }
      },
      {
        "id": "llm-1",
        "type": "llm",
        "name": "Grounded Interview Assistant",
        "config": {
          "provider": "ollama",
          "model": "llama3.2",
          "prompt": "You are a senior career advisor and technical interview coach. You have access to the interview_search tool and the following pre-retrieved context from the candidate's vbelle/Interview repository:\n\n{{previous}}\n\nAnswer the user's request thoroughly and accurately based on the retrieved context.",
          "timeout_seconds": 180
        },
        "position": {
          "x": 850,
          "y": 150
        }
      },
      {
        "id": "response-1",
        "type": "response",
        "name": "Display Answer",
        "config": {
          "content": "{{previous}}"
        },
        "position": {
          "x": 1100,
          "y": 150
        }
      }
    ],
    "edges": [
      {
        "id": "e-input-decision",
        "source": "input-1",
        "source_port": "default",
        "target": "decision-1"
      },
      {
        "id": "e-decision-exit",
        "source": "decision-1",
        "source_port": "true",
        "target": "exit-response"
      },
      {
        "id": "e-decision-memory",
        "source": "decision-1",
        "source_port": "false",
        "target": "memory-1"
      },
      {
        "id": "e-tool-llm",
        "source": "tool-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-memory-llm",
        "source": "memory-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-llm-success",
        "source": "llm-1",
        "source_port": "success",
        "target": "response-1"
      },
      {
        "id": "e-llm-failure",
        "source": "llm-1",
        "source_port": "failure",
        "target": "response-1"
      }
    ]
  }
}
