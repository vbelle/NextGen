{
  "name": "interview_knowledge_search",
  "graph_json": {
    "nodes": [
      {
        "id": "input-1",
        "type": "input",
        "name": "User Question",
        "config": {
          "prompt": "What interview question, company, system design, or prep topic would you like to search?",
          "required": true
        },
        "position": {
          "x": 100,
          "y": 150
        }
      },
      {
        "id": "tool-1",
        "type": "tool",
        "name": "Interview Search Tool",
        "config": {
          "function_name": "interview_search",
          "description": "Searches the candidate's Interview Knowledge Vault (vbelle/Interview) for prep notes, JDs, resume details, and cheatsheets.",
          "implementation_ref": "interview_search"
        },
        "position": {
          "x": 100,
          "y": 350
        }
      },
      {
        "id": "memory-1",
        "type": "memory",
        "name": "Interview Vault Memory RAG",
        "config": {
          "vector_store_ref": "interview_vault",
          "query": "{{previous}}",
          "top_k": 5
        },
        "position": {
          "x": 350,
          "y": 150
        }
      },
      {
        "id": "llm-1",
        "type": "llm",
        "name": "Grounded Interview Assistant",
        "config": {
          "provider": "ollama",
          "model": "llama3.2",
          "prompt": "You are a senior career advisor and technical interview coach. You have access to the interview_search tool and the following pre-retrieved context from the candidate's vbelle/Interview repository:\n\n{{previous}}\n\nAnswer the user's request thoroughly and accurately.",
          "timeout_seconds": 180
        },
        "position": {
          "x": 650,
          "y": 150
        }
      },
      {
        "id": "response-1",
        "type": "response",
        "name": "Display Answer",
        "config": {
          "content": "{{previous}}"
        },
        "position": {
          "x": 950,
          "y": 150
        }
      }
    ],
    "edges": [
      {
        "id": "e-input-memory",
        "source": "input-1",
        "source_port": "default",
        "target": "memory-1"
      },
      {
        "id": "e-tool-llm",
        "source": "tool-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-memory-llm",
        "source": "memory-1",
        "source_port": "default",
        "target": "llm-1"
      },
      {
        "id": "e-llm-success",
        "source": "llm-1",
        "source_port": "success",
        "target": "response-1"
      },
      {
        "id": "e-llm-failure",
        "source": "llm-1",
        "source_port": "failure",
        "target": "response-1"
      }
    ]
  }
}
